async def _local_llm_call(messages):
    """로컬 LLM(NVIDIA NIM → LM Studio) 호출. 둘 다 실패 시 자동 DeepSeek 폴백 트리거."""
    loop = asyncio.get_running_loop()
    if nvidia_client:
        try:
            print("🚀 [Engine] NVIDIA NIM (70B) 호출 중...")
            response = await loop.run_in_executor(None, lambda: nvidia_client.chat.completions.create(
                model="meta/llama-3.1-70b-instruct", messages=messages, temperature=0.7, max_tokens=2000
            ))
            return response.choices[0].message.content, "NVIDIA 70B"
        except Exception as e:
            print(f"⚠️ NVIDIA API 오류: {e}")
    try:
        print("💻 [Engine] LM Studio (Local) 호출 중...")
        response = await loop.run_in_executor(None, lambda: local_client.chat.completions.create(
            model="local-model", messages=messages, temperature=0.7, max_tokens=1500
        ))
        # 로컬 성공 시 폴백 상태였다면 복귀 처리
        if is_auto_fallback():
            clear_auto_fallback()
            with open(MODE_FILE, "w") as f:
                f.write("NIM/Local")
            print("✅ [AutoFallback] 로컬 엔진 복구 확인 → Gemma4 모드로 자동 복귀")
            if _fallback_notify_bot and _fallback_notify_chat_id:
                try:
                    await _fallback_notify_bot.send_message(
                        chat_id=_fallback_notify_chat_id,
                        text="✅ **[자동 복구]** 로컬 엔진(Gemma4)이 다시 정상 작동합니다.\nDeepSeek → **Gemma4 모드로 자동 복귀**했습니다.",
                        parse_mode="Markdown"
                    )
                except Exception:
                    pass
        return response.choices[0].message.content, "LM Studio (Gemma4)"
    except Exception as e:
        err_msg = str(e)
        print(f"❌ [AutoFallback] 로컬 엔진 실패 → DeepSeek 자동 전환: {err_msg}")
        # 자동 폴백 상태로 전환
        if not is_auto_fallback():
            set_auto_fallback(err_msg)
            # 텔레그램으로 자동 폴백 알림 전송
            if _fallback_notify_bot and _fallback_notify_chat_id:
                try:
                    await _fallback_notify_bot.send_message(
                        chat_id=_fallback_notify_chat_id,
                        text=f"⚠️ **[자동 폴백 발동]** 로컬 엔진(Gemma4)이 응답하지 않습니다.\n**DeepSeek 모드로 자동 전환**합니다.\n\n원인: `{err_msg[:200]}`",
                        parse_mode="Markdown"
                    )
                except Exception:
                    pass
        # DeepSeek로 즉시 폴백 호출
        return await _api_llm_call_safe(messages)

async def _api_llm_call_safe(messages):
    """DeepSeek 안전 호출 (폴백 전용 — 예외를 외부로 전파하지 않음)"""
    loop = asyncio.get_running_loop()
    if deepseek_client:
        try:
            print("🚀 [Engine] DeepSeek 폴백 호출 중...")
            response = await loop.run_in_executor(None, lambda: deepseek_client.chat.completions.create(
                model="deepseek-chat", messages=messages, temperature=0.7, max_tokens=2000
            ))
            return response.choices[0].message.content, "DeepSeek (자동폴백)"
        except Exception as e:
            return f"❌ DeepSeek 폴백도 실패했습니다: {e}", "Error"
    return "❌ DeepSeek 클라이언트가 초기화되지 않았습니다.", "Error"

async def _api_llm_call(messages):
    loop = asyncio.get_running_loop()
    if deepseek_client:
        print("🚀 [Engine] DeepSeek 호출 중...")
        response = await loop.run_in_executor(None, lambda: deepseek_client.chat.completions.create(
            model="deepseek-chat", messages=messages, temperature=0.7, max_tokens=2000
        ))
        return response.choices[0].message.content, "DeepSeek"
    raise Exception("DeepSeek 클라이언트가 초기화되지 않았습니다.")

