MODE_FILE = "/Users/bluesea/.hermes/llm_mode.txt"
FALLBACK_FILE = "/Users/bluesea/.hermes/llm_fallback.txt"  # 자동 폴백 발생 시 생성

def get_current_mode():
    if os.path.exists(MODE_FILE):
        with open(MODE_FILE, "r") as f:
            return f.read().strip()
    return "NIM/Local"

def is_auto_fallback():
    """현재 자동 폴백 상태인지 확인"""
    return os.path.exists(FALLBACK_FILE)

def set_auto_fallback(reason: str = ""):
    """자동 폴백 상태 설정 + DeepSeek 모드로 전환"""
    with open(FALLBACK_FILE, "w") as f:
        f.write(reason)
    with open(MODE_FILE, "w") as f:
        f.write("DeepSeek")

def clear_auto_fallback():
    """자동 폴백 상태 해제"""
    if os.path.exists(FALLBACK_FILE):
        os.remove(FALLBACK_FILE)

def toggle_mode():
    current = get_current_mode()
    new_mode = "DeepSeek" if current == "NIM/Local" else "NIM/Local"
    with open(MODE_FILE, "w") as f:
        f.write(new_mode)
    # 수동 모드 전환 시 자동 폴백 상태 초기화
    clear_auto_fallback()
    return new_mode

