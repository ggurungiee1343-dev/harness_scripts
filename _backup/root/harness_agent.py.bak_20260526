# ── 모드 정의 ────────────────────────────────────────────────
MODE_GEMMA4 = "Gemma4"
MODE_DEEPSEEK = "DeepSeek"
MODE_NVIDIA = "NVIDIA 70B"
ALL_MODES = [MODE_GEMMA4, MODE_DEEPSEEK, MODE_NVIDIA]
# 폴백 체인 (앞에서 실패 시 다음 것 시도)
FALLBACK_CHAIN = {
    MODE_GEMMA4:  [MODE_DEEPSEEK, MODE_NVIDIA],
    MODE_DEEPSEEK: [MODE_NVIDIA, MODE_GEMMA4],
    MODE_NVIDIA:   [MODE_DEEPSEEK, MODE_GEMMA4],
}

# ── 모드 라벨 (표시용) ───────────────────────────────────────
MODE_LABELS = {
    MODE_GEMMA4:  "🟢 Gemma4 (로컬)",
    MODE_DEEPSEEK: "🔵 DeepSeek (API)",
    MODE_NVIDIA:   "🟣 NVIDIA NIM 70B",
}

# LLM 모드 상태 (파일 기반으로 hermes_local과 상태 공유)
MODE_FILE = "/Users/bluesea/.hermes/llm_mode.txt"
FALLBACK_FILE = "/Users/bluesea/.hermes/llm_fallback.txt"

def get_current_mode():
    if os.path.exists(MODE_FILE):
        val = open(MODE_FILE).read().strip()
        # 이전 "NIM/Local" 값 마이그레이션
        if val == "NIM/Local":
            return MODE_GEMMA4
        return val if val in ALL_MODES else MODE_GEMMA4
    return MODE_GEMMA4

def set_mode(mode: str):
    """모드 설정 + 자동 폴백 상태 초기화"""
    if mode not in ALL_MODES:
        mode = MODE_GEMMA4
    with open(MODE_FILE, "w") as f:
        f.write(mode)
    clear_auto_fallback()
    return mode

def is_auto_fallback():
    return os.path.exists(FALLBACK_FILE)

def set_auto_fallback(reason: str = ""):
    """자동 폴백 상태 설정 (모드 파일은 건드리지 않음 — fallback에서만 읽음)"""
    with open(FALLBACK_FILE, "w") as f:
        f.write(reason)

def clear_auto_fallback():
    if os.path.exists(FALLBACK_FILE):
        os.remove(FALLBACK_FILE)

# [v3.7] IngestEngine에 LLM 래퍼 연결 (지능형 파일 분류 활성화)
async def ingest_llm_wrapper(prompt):
    messages = [{"role": "user", "content": prompt}]
    ans, _ = await get_llm_response(messages)
    return ans

if ingest_inst:
    ingest_inst.llm_func = ingest_llm_wrapper

