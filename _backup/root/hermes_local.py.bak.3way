# ── 지연 로딩 캐시 ──────────────────────────────────────────────────────────
_module_cache = {}

def _load_module(name: str):
    if name not in _module_cache:
        _module_cache[name] = importlib.import_module(name)
    return _module_cache[name]

# ── 로거 ───────────────────────────────────────────────────────────────────
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("HermesOrchestrator")

# ── Global error handler ───────────────────────────────────────────────────
async def global_error_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    err = context.error
    if isinstance(err, Conflict):
        logger.warning(f"Telegram Conflict error: {err}")
        return
    elif isinstance(err, TelegramError):
        logger.error(f"Telegram error: {err}")
        return
    else:
        logger.exception(f"Unexpected error: {err}")
        return

