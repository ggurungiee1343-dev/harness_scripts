# 🔒 무의존성 .env 환경 변수 로더
def load_custom_env(env_path=Path("/Users/bluesea/.hermes/.env")):
    if env_path.exists():
        with open(env_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    if "=" in line:
                        k, v = line.split("=", 1)
                        val = v.strip().strip("'\"")
                        os.environ[k.strip()] = val

load_custom_env()

