def main():
    # ── 단일 인스턴스 잠금 ─────────────────────────────────────────────────
    LOCK_FILE = Path(Path.home() / ".hermes" / "hermes_local.lock")
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    lock_fp = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fp, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("⚠️  다른 hermes_local 인스턴스가 이미 실행 중입니다. 종료합니다.")
        sys.exit(0)
    atexit.register(lambda: (fcntl.flock(lock_fp, fcntl.LOCK_UN), lock_fp.close()))
    atexit.register(_run_end_hook)

    if not TOKEN:
        print("❌ TELEGRAM_BOT_TOKEN이 설정되지 않았습니다. .env 파일을 다시 확인해 주세요.")
        sys.exit(1)

    init_dir()
    app = Application.builder().token(TOKEN).build()

    # ── 봇 재시작 시 자동으로 키보드 재전송 ──────────────────────────────
    async def post_init(application):
        try:
            await application.bot.send_message(
                chat_id=ALLOWED_ID,
                text="🔄 **Harness V2.5 재가동 완료** — 하단 버튼 메뉴를 복원합니다.",
                reply_markup=_make_keyboard(),
                parse_mode="Markdown"
            )
        except Exception as e:
            print(f"[post_init] 키보드 자동 전송 실패 (무시): {e}")
    app.post_init = post_init

    # ── 서브 모듈 핸들러 동적 바인딩 (순환 참조 방지) ────────────────────
    def _load_handler(name):
        mod = _load_module('hermes_handlers')
        return getattr(mod, name)

    cmd_start              = lambda *a, **kw: _load_handler('cmd_start')(*a, **kw)
    async def cmd_help(update, context):
        if not await check_user(update): return
        await update.message.reply_text(HELP_TEXT, parse_mode='Markdown')
    cmd_ask                = lambda *a, **kw: _load_handler('cmd_ask')(*a, **kw)
    cmd_cove               = lambda *a, **kw: _load_handler('cmd_cove')(*a, **kw)
    cmd_web                = lambda *a, **kw: _load_handler('cmd_web')(*a, **kw)
    cmd_ingest             = lambda *a, **kw: _load_handler('cmd_ingest')(*a, **kw)
    cmd_dreaming           = lambda *a, **kw: _load_handler('cmd_dreaming')(*a, **kw)
    cmd_exec               = lambda *a, **kw: _load_handler('cmd_exec')(*a, **kw)
    cmd_clip               = lambda *a, **kw: _load_handler('cmd_clip')(*a, **kw)
    cmd_recent             = lambda *a, **kw: _load_handler('cmd_recent')(*a, **kw)
    cmd_status             = lambda *a, **kw: _load_handler('cmd_status')(*a, **kw)
    async def handle_button_callback(update, context):
        query = update.callback_query
        if query and query.data and query.data.startswith('paper_'):
            try:
                if query.data.startswith('paper_back_'):
                    return await _web.handle_paper_back(update, context)
                return await _web.handle_paper_callback(update, context)
            except Exception as e:
                print(f"⚠️ [paper_callback] 오류: {e}")
                await query.answer("⚠️ 논문 정보 처리 중 오류가 발생했습니다.")
                return
        orig = _load_handler('handle_button_callback')
        return await orig(update, context)
    handle_text_message    = lambda *a, **kw: _load_handler('handle_text_message')(*a, **kw)

    # 🔧 hermes_handlers.cmd_help monkey-patch (ℹ️ 도움말 버튼에서도 HELP_TEXT 사용)
    _load_module('hermes_handlers').cmd_help = cmd_help

    # ── hermes_file_ops 지연 로드 (순환 임포트 방지) ──────────────────────
    try:
        _fops = _load_module('hermes_file_ops')
        cmd_create  = _fops.cmd_create
        cmd_read    = _fops.cmd_read
        cmd_move    = _fops.cmd_move
        cmd_copy    = _fops.cmd_copy
        cmd_delete  = _fops.cmd_delete
        cmd_rename  = _fops.cmd_rename
        cmd_list    = _fops.cmd_list
        cmd_confirm = _fops.cmd_confirm
        cmd_cancel  = _fops.cmd_cancel
        FILE_OPS_ENABLED = True
    except Exception as e:
        FILE_OPS_ENABLED = False
        print(f"⚠️ [hermes_file_ops] 로드 실패 (무시): {e}")

    # ── hermes_harness 지연 로드 ───────────────────────────────────────────
    try:
        _harn = _load_module('hermes_harness')
        cmd_harness  = _harn.cmd_harness
        cmd_hdod     = _harn.cmd_hdod
        cmd_hstatus  = _harn.cmd_hstatus
        cmd_hrollback = _harn.cmd_hrollback
        LOCAL_HARNESS_ENABLED = True
    except Exception as e:
        LOCAL_HARNESS_ENABLED = False
        print(f"⚠️ [hermes_harness] 로드 실패 (무시): {e}")

    # ── Bio-Memory Patch 로드 ─────────────────────────────────────────────
    try:
        _mem = _load_module('hermes_memory_patch')
        _mem.init_bio_memory()
        cmd_memory        = _mem.cmd_memory
        cmd_memory_search = _mem.cmd_memory_search
        cmd_memory_dream  = _mem.cmd_memory_dream
        cmd_memory_audit  = _mem.cmd_memory_audit
        BIO_MEM_ENABLED = True
    except Exception:
        BIO_MEM_ENABLED = False

    # ── 웹 검색 에이전트 로드 ─────────────────────────────────────────
    try:
        _web = _load_module('web_agent_module')
        web_agent = _web.WebAgentSkills()
        WEB_AGENT_ENABLED = True
    except Exception:
        WEB_AGENT_ENABLED = False

    # ── harness_agent 통합 (단일 봇 통합 핵심) ──────────────────────────
    # harness_agent.py는 라이브러리 모드로 동작하며,
    # handle_message() 함수만 import하여 일반 텍스트 메시지 수신 시 호출합니다.
    HARNESS_AGENT_ENABLED = False
    harness_handle_message = None
    harness_auto_heal = None
    try:
        _ha = _load_module('harness_agent')
        harness_handle_message = _ha.handle_message
        harness_auto_heal = getattr(_ha.sys_mon, 'auto_heal', None)
        HARNESS_AGENT_ENABLED = True
        print("✅ [harness_agent] 라이브러리 모드로 정상 연동되었습니다.")

        # 🐛 핵심 수정: hermes_handlers.pyc가 line 279에서 이미 DummyRouter를 복사했으므로
        # 실제 HybridRouter로 직접 덮어쓰기 (from import는 값을 복사하므로 patch_router만으로 부족)
        import hybrid_router as _hr
        _hmod = sys.modules.get('hermes_handlers')
        if _hmod and hasattr(_hmod, 'router'):
            _hmod.router = _hr.router
            print("  └─ hermes_handlers.router → HybridRouter로 교체 완료 🎯", flush=True)
        else:
            try:
                import hermes_handlers as _hh
                _hh.router = _hr.router
                print("  └─ hermes_handlers.router → HybridRouter로 교체 완료 (강제 로드) 🎯", flush=True)
            except Exception as _reload_e:
                print(f"  ❌ hermes_handlers.router 교체 실패: {_reload_e}", flush=True)
    except Exception as e:
        print(f"⚠️ [harness_agent] 연동 실패 (무시): {e}")

    # ── 핸들러 등록 ───────────────────────────────────────────────────────
    app.add_handler(CommandHandler("start",    cmd_start))
    app.add_handler(CommandHandler("menu",     cmd_start))
    app.add_handler(CommandHandler("help",     cmd_help))
    app.add_handler(CommandHandler("ask",      cmd_ask))
    app.add_handler(CommandHandler("cove",     cmd_cove))
    app.add_handler(CommandHandler("web",      cmd_web))
    app.add_handler(CommandHandler("ingest",   cmd_ingest))
    app.add_handler(CommandHandler("dreaming", cmd_dreaming))
    app.add_handler(CommandHandler("exec",     cmd_exec))
    app.add_handler(CommandHandler("clip",     cmd_clip))
    app.add_handler(CommandHandler("recent",   cmd_recent))
    app.add_handler(CommandHandler("status",   cmd_status))

    if FILE_OPS_ENABLED:
        app.add_handler(CommandHandler("create",  cmd_create))
        app.add_handler(CommandHandler("read",    cmd_read))
        app.add_handler(CommandHandler("move",    cmd_move))
        app.add_handler(CommandHandler("copy",    cmd_copy))
        app.add_handler(CommandHandler("delete",  cmd_delete))
        app.add_handler(CommandHandler("rename",  cmd_rename))
        app.add_handler(CommandHandler("list",    cmd_list))
        app.add_handler(CommandHandler("confirm", cmd_confirm))
        app.add_handler(CommandHandler("cancel",  cmd_cancel))

    if LOCAL_HARNESS_ENABLED:
        app.add_handler(CommandHandler("harness",   cmd_harness))
        app.add_handler(CommandHandler("hdod",      cmd_hdod))
        app.add_handler(CommandHandler("hstatus",   cmd_hstatus))
        app.add_handler(CommandHandler("hrollback", cmd_hrollback))

    if BIO_MEM_ENABLED:
        app.add_handler(CommandHandler("memory",        cmd_memory))
        app.add_handler(CommandHandler("memory_search", cmd_memory_search))
        app.add_handler(CommandHandler("memory_dream",  cmd_memory_dream))
        app.add_handler(CommandHandler("memory_audit",  cmd_memory_audit))

    if WEB_AGENT_ENABLED:
        app.add_handler(CommandHandler("search",      web_agent.cmd_search))
        app.add_handler(CommandHandler("readweb",     web_agent.cmd_readweb))
        app.add_handler(CommandHandler("searchpaper", web_agent.cmd_searchpaper))

    # ── Profile Manager ─────────────────────────────────────────────
    try:
        from modules.profile_manager import set_profile as _set_profile, list_profiles as _list_profiles
        async def cmd_profile(update: Update, context: ContextTypes.DEFAULT_TYPE):
            from telegram.constants import ParseMode
            args = context.args
            if not args:
                reply = _list_profiles()
            else:
                reply = _set_profile(args[0])
            await update.message.reply_text(reply, parse_mode=ParseMode.MARKDOWN)
        app.add_handler(CommandHandler("profile", cmd_profile))
    except Exception:
        pass

    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text_message))
    app.add_handler(CallbackQueryHandler(handle_button_callback))
    app.add_error_handler(global_error_handler)

    # ── harness_agent auto_heal 백그라운드 루프 등록 ─────────────────────────
    if HARNESS_AGENT_ENABLED:
        async def _post_init_harness(application):
            import asyncio
            import config as _cfg
            async def _auto_heal_loop():
                while True:
                    try:
                        import os
                        _ha_mod = _load_module('harness_agent')
                        _ha_mod.sys_mon.auto_heal(os.path.join(str(_cfg.SCRIPTS_DIR), "recovery_system.sh"))
                    except Exception:
                        pass
                    await asyncio.sleep(300)
            asyncio.create_task(_auto_heal_loop())

        _orig_post_init = getattr(app, 'post_init', None)
        async def _combined_post_init(application):
            if _orig_post_init:
                await _orig_post_init(application)
            await _post_init_harness(application)
        app.post_init = _combined_post_init

    print("🚀 [Harness V2.5] CoVe 팩트체크 및 자율 제어 헤르메스 관제탑이 정상 가동되었습니다.")
    print(f"🛡️ [하네스 레이어] ACID 에이전트 제어 하네스 {'활성화' if HARNESS_ENABLED else '비활성화 (모듈 없음)'}")

    # ── 메모리 자동 정리 프로세스 시작 ───────────────────────────────────
    try:
        if _MODULES_DIR not in sys.path:
            sys.path.append(_MODULES_DIR)
        from graph_memory import MemoryConsolidator
        consolidator = MemoryConsolidator(idle_threshold_seconds=300)
        consolidator.start_background()
        print("🧠 [Memory] 지식 그래프(NetworkX) 자동 정리 백그라운드 모듈 시작됨")
    except ImportError as e:
        print(f"⚠️ [Memory] MemoryConsolidator 모듈 로드 실패: {e}")

    app.run_polling()


if __name__ == "__main__":
    main()
