def init_dir():
    """작업 폴더 무결성 확인 및 자동 개설"""
    BASE_DIR.mkdir(parents=True, exist_ok=True)
    (BASE_DIR / "inbox").mkdir(exist_ok=True)
    (BASE_DIR / "working").mkdir(exist_ok=True)
    (BASE_DIR / "outbox").mkdir(exist_ok=True)


async def check_user(update: Update) -> bool:
    """박사님 아이디 전용 보안 필터"""
    if not update.effective_user or update.effective_user.id != ALLOWED_ID:
        return False
    return True


def secure_path(user_path_str: str) -> Path:
    """경로 이탈 방지 및 NFC 한글 정규화 — 3개 허용 Base 내에서만 접근"""
    normalized_str = unicodedata.normalize('NFC', user_path_str)
    clean_str = normalized_str.lstrip('/')
    # 어느 BASE에 속하는지 찾기
    target_path = None
    for base in ALLOWED_BASES:
        candidate = (base / clean_str).resolve()
        try:
            candidate.relative_to(base)
            target_path = candidate
            break
        except ValueError:
            continue
    if target_path is None:
        # 절대경로로 직접 시도
        abs_path = Path(clean_str).resolve() if clean_str else None
        if abs_path:
            for base in ALLOWED_BASES:
                try:
                    abs_path.relative_to(base)
                    target_path = abs_path
                    break
                except ValueError:
                    continue
    if target_path is None:
        raise PermissionError(
            "Access Denied: 허용된 작업 공간 외부의 경로입니다.\n"
            f"허용 경로: {', '.join(str(b) for b in ALLOWED_BASES)}"
        )
    return target_path


def _make_keyboard():
    """하단 버튼 키보드 생성 (단일 정의, 전체 공유)"""
    keyboard = [
        [KeyboardButton("🌙 Dreaming"), KeyboardButton("📁 최근 문서")],
        [KeyboardButton("📥 Ingest"),   KeyboardButton("ℹ️ 도움말")],
        [KeyboardButton("🧠 메모리"),    KeyboardButton("🔄 모드 전환")],
    ]
    return ReplyKeyboardMarkup(keyboard, resize_keyboard=True, one_time_keyboard=False)


# ── 세션 종료 훅 (Layer 4: Memory Close-out) ──────────────────────────────────
def _run_end_hook():
    """atexit 등록용: hooks/end.sh 실행 (Obsidian Codex 동기화 + 텔레그램 알림)"""
    import logging as _log
    hook_path = os.path.expanduser("~/.hermes/hooks/end.sh")
    if os.path.exists(hook_path):
        try:
            result = subprocess.run(
                ["bash", hook_path],
                capture_output=True, text=True, timeout=30
            )
            if result.returncode == 0:
                _log.getLogger("HermesOrchestrator").info(
                    f"[Close-out] end.sh 완료: {result.stdout.strip()}"
                )
            else:
                _log.getLogger("HermesOrchestrator").warning(
                    f"[Close-out] end.sh 오류 (code={result.returncode}): {result.stderr.strip()}"
                )
        except Exception as e:
            _log.getLogger("HermesOrchestrator").exception(
                f"[Close-out] end.sh 실행 실패: {e}"
            )


# =============================================================================
# 🚀 메인 진입점
