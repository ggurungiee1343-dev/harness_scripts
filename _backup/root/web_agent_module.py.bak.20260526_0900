"""
web_agent_module.py — 대화형 웹 검색 및 읽기 에이전트 모듈 (옵션 1 + 옵션 2 통합본)
================================================================
Hermes V2.5 (hermes_local.py) 에 연동하여 구글/빙 수준의 웹 검색과 
지정한 웹페이지의 본문 추출을 수행하는 모듈입니다.

필요 패키지 설치:
  pip install aiohttp duckduckgo-search

[옵션 1: LLM Function Calling 용 함수]
LLM(OpenAI 등)의 tools/functions 에 아래 두 함수를 등록하여 사용할 수 있습니다.
  1. search_web(query)
  2. read_webpage(url)

[옵션 2: 수동 텔레그램 명령어]
  /search [검색어]   — 일반 웹 검색을 수행하고 1~5번까지 리스트를 보여줍니다.
  /readweb [번호]    — 위에서 검색된 리스트 중 하나를 선택해 본문을 추출합니다.
"""

import asyncio
import aiohttp
import json
from duckduckgo_search import DDGS
import uuid
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ContextTypes

# ── Action Realization Layer (Life-Harness Layer ❸) ────────────────────
from modules.action_realization_layer import ActionRealizationLayer
_action_layer = ActionRealizationLayer.get_instance()

# 검색 결과를 유저별로 임시 저장하기 위한 메모리 딕셔너리
user_search_memory = {}

# /searchpaper 결과 캐시 (인라인 버튼 상세보기용)
_paper_cache = {}

# ─────────────────────────────────────────────────────────────────────────────
# [옵션 1] LLM Function Calling을 위한 순수 Python 함수들 (자율형 에이전트용)
# ─────────────────────────────────────────────────────────────────────────────

async def search_web(query: str, max_results: int = 5) -> list:
    """
    (LLM Tool) 웹에서 검색어를 검색하여 제목, URL, 요약(snippet) 리스트를 반환합니다.
    """
    loop = asyncio.get_event_loop()
    try:
        results = await loop.run_in_executor(None, lambda: list(DDGS().text(query, max_results=max_results)))
        return results
    except Exception as e:
        return [{"error": str(e)}]

async def read_webpage(url: str, max_length: int = 3500) -> str:
    """
    (LLM Tool) 특정 URL의 웹페이지에 접속하여 광고를 제거하고 본문만 마크다운으로 추출합니다.
    """
    jina_url = f"https://r.jina.ai/{url}"
    headers = {"User-Agent": "HermesWebAgent/1.0"}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(jina_url, headers=headers, timeout=20) as resp:
                if resp.status == 200:
                    content = await resp.text()
                    if len(content) > max_length:
                        return content[:max_length] + "\n\n...(본문이 너무 길어 생략됨)"
                    return content
                else:
                    return f"Error: Cannot access webpage (Status: {resp.status})"
    except Exception as e:
        return f"Error reading webpage: {str(e)}"


# ─────────────────────────────────────────────────────────────────────────────
# [옵션 1-2] OpenAlex 학술 논문 검색 (무료, API 키 불필요)
# ─────────────────────────────────────────────────────────────────────────────

async def search_academic_papers(query: str, max_results: int = 5) -> list:
    """
    (LLM Tool) OpenAlex API를 통해 학술 논문을 검색합니다.
    무료, API 키 불필요, 전 분야(법학 포함) 지원, 한글 검색 가능.
    """
    import urllib.parse
    encoded_query = urllib.parse.quote(query)
    url = (
        f"https://api.openalex.org/works"
        f"?filter=default.search:{encoded_query}"
        f"&sort=cited_by_count:desc"
        f"&per_page={max_results}"
    )
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=15) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    results = data.get("results", [])
                    papers = []
                    for r in results:
                        title = r.get("title") or r.get("display_name", "제목 없음")
                        year = r.get("publication_year", "?")
                        citations = r.get("cited_by_count", 0)
                        doi = r.get("doi", "")
                        # 저자 추출
                        authors = []
                        for a in r.get("authorships", []):
                            author_name = a.get("author", {}).get("display_name", "")
                            if author_name:
                                authors.append(author_name)
                        author_str = ", ".join(authors[:3])
                        if len(authors) > 3:
                            author_str += " et al."
                        # 저널명
                        journal = ""
                        loc = r.get("primary_location", {}) or {}
                        src = loc.get("source", {}) or {}
                        if src.get("display_name"):
                            journal = src["display_name"]
                        
                        papers.append({
                            "title": title,
                            "year": year,
                            "citations": citations,
                            "doi": doi,
                            "authors": author_str,
                            "journal": journal,
                        })
                    return papers
                else:
                    return [{"error": f"OpenAlex API 오류 (Status: {resp.status})"}]
    except Exception as e:
        return [{"error": str(e)}]


# ─────────────────────────────────────────────────────────────────────────────
# [옵션 2] 텔레그램 챗봇 명령어 핸들러 (수동 호출용)
