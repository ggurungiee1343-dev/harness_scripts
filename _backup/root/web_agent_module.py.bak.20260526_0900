class WebAgentSkills:
    async def cmd_search(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """일반 웹 검색 명령어 (/search 검색어)"""
        args = context.args
        if not args:
            await update.message.reply_text("❗ 검색어를 입력해 주세요.\n예: `/search 한국 선박조선 최근 1년 논문`", parse_mode="Markdown")
            return

        query = " ".join(args)
        
        # 🔒 Action Realization Layer 검증
        search_result = _action_layer.validate("search", query=query)
        if not search_result.valid:
            await update.message.reply_text(f"❌ {search_result.message}\n💡 {search_result.suggestion}")
            return
        
        user_id = update.effective_user.id
        
        await update.message.reply_text(f"🔍 `{query}` 검색 중...", parse_mode="Markdown")

        results = await search_web(query)

        if not results or "error" in results[0]:
            error_msg = results[0].get("error", "결과가 없습니다.") if results else "결과가 없습니다."
            await update.message.reply_text(f"❌ 검색 실패: {error_msg}")
            return

        # 메모리 초기화 및 저장
        user_search_memory[user_id] = {}
        
        lines = [f"🌐 **'{query}' 검색 결과**\n"]
        for idx, res in enumerate(results, 1):
            title = res.get('title', '제목 없음')
            link = res.get('href', '')
            snippet = res.get('body', '')
            
            # 메모리에 URL 저장
            user_search_memory[user_id][idx] = link
            
            lines.append(f"**[{idx}]** {title}")
            lines.append(f"📝 {snippet}")
            lines.append(f"🔗 {link}\n")
            
        lines.append("💡 *본문을 읽고 요약하려면 `/readweb 1` 형식으로 번호를 입력하세요.*")
        
        await update.message.reply_text("\n".join(lines), parse_mode="Markdown", disable_web_page_preview=True)

    async def cmd_readweb(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """지정된 번호 또는 URL의 본문을 추출하는 명령어 (/readweb 번호 또는 URL)"""
        args = context.args
        if not args:
            await update.message.reply_text("❗ 읽을 번호나 URL을 입력해 주세요.\n예: `/readweb 1` 또는 `/readweb https://...`", parse_mode="Markdown")
            return

        target = args[0]
        url_to_read = None
        user_id = update.effective_user.id

        if target.isdigit():
            idx = int(target)
            if user_id in user_search_memory and idx in user_search_memory[user_id]:
                url_to_read = user_search_memory[user_id][idx]
            else:
                await update.message.reply_text(f"❌ 이전에 검색한 결과 중 {idx}번을 찾을 수 없습니다. 다시 검색(`/search`)해 주세요.")
                return
        elif target.startswith("http"):
            url_to_read = target
            
            # 🔒 Action Realization Layer 검증 (직접 URL 입력 시)
            url_result = _action_layer.validate("url", url=url_to_read)
            if not url_result.valid:
                await update.message.reply_text(f"❌ {url_result.message}\n💡 {url_result.suggestion}")
                return
            url_to_read = url_result.canonicalized or url_to_read
        else:
            await update.message.reply_text("❗ 올바른 번호(1~5) 또는 URL을 입력해 주세요.")
            return

        await update.message.reply_text(f"📄 문서 읽는 중...\n🔗 {url_to_read}", disable_web_page_preview=True)

        content = await read_webpage(url_to_read)
        
        if content.startswith("Error"):
            await update.message.reply_text(f"❌ {content}")
        else:
            # 봇이 이어받아서 답변할 수 있도록 문구 추가
            content += "\n\n(헤르메스 봇님, 위 내용을 바탕으로 요약/조사 결과를 유저에게 알려주세요!)"
            final_msg = f"📚 **본문 추출 완료**\n\n{content}"
            
            await update.message.reply_text(final_msg, parse_mode="Markdown", disable_web_page_preview=True)

    async def cmd_searchpaper(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """/searchpaper 검색어 [개수] — OpenAlex 학술 논문 검색 (무료, 법학 포함 전 분야)"""
        args = context.args
        if not args:
            await update.message.reply_text(
                "❗ 검색어를 입력해 주세요.\n"
                "예: `/searchpaper 한국 민법 개정`\n"
                "예: `/searchpaper legal reasoning AI`\n"
                "예: `/searchpaper machine learning 10` (최대 20개)",
                parse_mode="Markdown"
            )
            return

        # 마지막 인자가 숫자면 max_results로 사용
        max_results = 5
        try:
            last_arg = args[-1]
            n = int(last_arg)
            if 1 <= n <= 20:
                max_results = n
                args = args[:-1]  # 숫자는 검색어에서 제외
            # n이 범위 밖이면 그냥 검색어 일부로 취급
        except (ValueError, IndexError):
            pass

        query = " ".join(args)

        # 🔒 Action Realization Layer 검증
        paper_result = _action_layer.validate("paper_search", query=query)
        if not paper_result.valid:
            await update.message.reply_text(f"❌ {paper_result.message}\n💡 {paper_result.suggestion}")
            return

        await update.message.reply_text(f"📚 **`{query}`** 학술 논문 검색 중... (OpenAlex, 최대 {max_results}개)", parse_mode="Markdown")

        papers = await search_academic_papers(query, max_results=max_results)

        if not papers:
            await update.message.reply_text("❌ 검색 결과가 없습니다.")
            return

        if "error" in papers[0]:
            await update.message.reply_text(f"❌ 검색 실패: {papers[0]['error']}")
            return

        # 🔖 캐시에 저장 (인라인 버튼용)
        cache_key = str(uuid.uuid4())[:8]
        _paper_cache[cache_key] = papers

        lines = [f"📖 **'{query}' 논문 검색 결과**\n"]
        keyboard = []
        for idx, p in enumerate(papers):
            idx1 = idx + 1
            title_short = p["title"][:36] + "…" if len(p["title"]) > 36 else p["title"]
            doi_short = p["doi"].replace("https://doi.org/", "") if p["doi"] else ""
            lines.append(f"**[{idx1}]** {p['title']}")
            lines.append(f"👤 {p['authors']} ({p['year']})")
            if p["journal"]:
                lines.append(f"📰 {p['journal']}")
            lines.append(f"📊 인용 {p['citations']}회")
            if doi_short:
                lines.append(f"🔗 DOI: `{doi_short}`")
            lines.append("")
            # 각 논문에 상세보기 버튼
            keyboard.append([InlineKeyboardButton(f"🔍 {idx1}. {title_short}", callback_data=f"paper_{cache_key}_{idx}")])

        keyboard.append([InlineKeyboardButton("❌ 닫기", callback_data="paper_close")])

        await update.message.reply_text(
            "\n".join(lines),
            parse_mode="Markdown",
            disable_web_page_preview=True,
            reply_markup=InlineKeyboardMarkup(keyboard)
        )


# ── /searchpaper 인라인 버튼 콜백 핸들러 ──────────────────────────────
async def handle_paper_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """paper_xxx 콜백 처리: 버튼 누르면 해당 논문 상세 정보 표시"""
    query = update.callback_query
    data = query.data

    # ❌ 닫기 버튼
    if data == "paper_close":
        await query.edit_message_text(query.message.text + "\n\n❌ 검색 결과를 닫았습니다.")
        await query.answer()
        return

    # paper_{cache_key}_{idx} 파싱
    parts = data.split("_", 2)
    if len(parts) != 3:
        await query.answer("⚠️ 잘못된 요청입니다.")
        return

    _, cache_key, idx_str = parts
    try:
        idx = int(idx_str)
    except ValueError:
        await query.answer("⚠️ 잘못된 요청입니다.")
        return

    papers = _paper_cache.get(cache_key)
    if not papers or idx >= len(papers):
        await query.answer("⚠️ 검색 결과가 만료되었습니다. 다시 /searchpaper 해주세요.")
        return

    p = papers[idx]

    # 상세 정보 문자열 조립
    lines = [
        f"📖 **{p['title']}**",
        f"👤 {p['authors']} ({p['year']})",
    ]
    if p.get("journal"):
        lines.append(f"📰 {p['journal']}")
    lines.append(f"📊 인용 {p['citations']}회")
    if p.get("doi"):
        doi = p["doi"]
        doi_short = doi.replace("https://doi.org/", "")
        lines.append(f"🔗 DOI: [{doi_short}]({doi})")

    # OpenAlex 상세 링크
    lines.append(f"\n🔬 [OpenAlex에서 보기](https://openalex.org/works?search={p['title'][:50]})")

    # 뒤로가기 버튼
    keyboard = [[InlineKeyboardButton("◀ 목록으로", callback_data=f"paper_back_{cache_key}")]]
    keyboard.append([InlineKeyboardButton("❌ 닫기", callback_data="paper_close")])

    await query.edit_message_text(
        "\n".join(lines),
        parse_mode="Markdown",
        disable_web_page_preview=True,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )
    await query.answer()


# ── paper_back 콜백 (목록으로 돌아가기) ────────────────────────────────
async def handle_paper_back(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """paper_back_xxx 콜백: 상세보기에서 검색 목록으로 복원"""
    query = update.callback_query
    data = query.data
    # data = paper_back_{cache_key}
    cache_key = data.split("_", 2)[2]
    papers = _paper_cache.get(cache_key)
    if not papers:
        await query.answer("⚠️ 검색 결과가 만료되었습니다.")
        return

    lines = ["📖 **검색 결과**\n"]
    for idx, p in enumerate(papers):
        idx1 = idx + 1
        doi_short = p["doi"].replace("https://doi.org/", "") if p["doi"] else ""
        lines.append(f"**[{idx1}]** {p['title']}")
        lines.append(f"👤 {p['authors']} ({p['year']})")
        if p["journal"]:
            lines.append(f"📰 {p['journal']}")
        lines.append(f"📊 인용 {p['citations']}회")
        if doi_short:
            lines.append(f"🔗 DOI: `{doi_short}`")
        lines.append("")

    keyboard = []
    for idx, p in enumerate(papers):
        title_short = p["title"][:36] + "…" if len(p["title"]) > 36 else p["title"]
        keyboard.append([InlineKeyboardButton(f"🔍 {idx+1}. {title_short}", callback_data=f"paper_{cache_key}_{idx}")])
    keyboard.append([InlineKeyboardButton("❌ 닫기", callback_data="paper_close")])

    await query.edit_message_text(
        "\n".join(lines),
        parse_mode="Markdown",
        disable_web_page_preview=True,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )
    await query.answer()
